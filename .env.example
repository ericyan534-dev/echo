# --- Predictor (LLM) ---
# Provider: gemini (default) | claude | deepseek | local | mock | demo_fallback
PREDICTOR_PROVIDER=gemini
# Failover chain: providers raced behind PREDICTOR_PROVIDER, in order. If the
# primary returns nothing, errors, or is slow (>1.2 s) the next one answers.
# Always set this for a live demo -- a provider 503 must never be an empty card.
PREDICTOR_FALLBACKS=gemini

# Gemini (current default)
GEMINI_API_KEY=
# GOOGLE_API_KEY=           # alternate name backend/config.py also accepts for GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash

# Claude — to swap back, set PREDICTOR_PROVIDER=claude and fill these in.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Demo-day network fallback (default OFF) ---
# Set PREDICTOR_PROVIDER=demo_fallback to wrap the inner provider below with a
# committed local backup (backend/predictor/demo_fallback_words.json) that
# fires ONLY on a live-call timeout/exception -- the rehearsed venue-Wi-Fi-
# drops safety net. Never a first choice, never on a successful-but-empty
# result. See docs/DEMO_SCRIPT.md "3-tier fallback drill" for the disclosure
# rule: never headline it; every fallback serve logs an ASCII line to the
# server console.
# PREDICTOR_PROVIDER=demo_fallback
# DEMO_FALLBACK_INNER=gemini          # inner live provider: gemini | claude
# DEMO_FALLBACK_TIMEOUT_S=1.5         # seconds before falling back to the local lookup

# --- Speech-to-text ---
# Provider: mock (default, scripted) | deepgram (live, needs wiring)
STT_PROVIDER=mock
DEEPGRAM_API_KEY=

# --- Tuning ---
MAX_CANDIDATES=3
STALL_PAUSE_MS=1300
CONTEXT_TURNS=6

# --- Acoustic channel ---
# Path to the trained FillerNet checkpoint; leave the file absent (or unset
# this) to run prolongation-only (still demos, see README "Acoustic model").
ACOUSTIC_MODEL=models/fillernet.pt
# Filler confidence threshold (P(uh)+P(um)); see backend/acoustic/stream.py.
ACOUSTIC_CONF=0.75

# --- Speculative prefetch ---
PREFETCH=on
PREFETCH_EVERY=3

# --- Salient-entity memory ---
# Injects names/things mentioned BEFORE the recent-context window into the
# prompt (backend/entities.py). Default on: measured 0/20 -> 19/20 recovery
# of out-of-window proper nouns on the frozen long-context set (docs/EVAL.md).
ENTITY_MEMORY=on
